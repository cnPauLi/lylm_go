# ===== 应用配置 =====
# 运行环境：development | production
APP_ENV=production
# 项目根目录（留空则自动取可执行文件所在目录；开发时可用 go run 的当前目录）
APP_ROOT=
# 监听地址与端口
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Gin 运行模式：debug | release | test
SERVER_MODE=release
# 后台目录名
ADMIN_PATH=admin

# ===== 数据库配置 =====
# 驱动：sqlite | mysql
DB_DRIVER=sqlite
# SQLite 数据库文件（相对项目根目录）
SQLITE_PATH=data/lylme.db
# 自定义 DSN（留空则按上方字段自动拼接，优先级最高）
DB_DSN=

# MySQL（仅 DB_DRIVER=mysql 时生效）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=lylme
MYSQL_CHARSET=utf8mb4

# ===== 日志配置 =====
# 日志目录（相对项目根目录）
LOG_DIR=logs
# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ===== 会话配置 =====
# 会话密钥，请务必修改为随机字符串
SESSION_SECRET=lylme_spage_session_secret_change_me

# ===== 静态资源 CDN =====
# 留空则使用本地 ./assets
CDN_PUBLIC=
